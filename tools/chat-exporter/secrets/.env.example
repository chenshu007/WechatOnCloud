# Required: target WOC instance ID (from `docker ps`, e.g. woc-wx-<ID>)
WOC_INSTANCE_ID=your_instance_id_here

# Local-only output directory (keep outside cloud sync / backup allowlists!)
EXPORT_OUT_DIR=/volume4/woc-chat-exports

# Output ownership & permissions (dirs=750, files=640) for local AI Agent :ro mounts
EXPORT_UID=1000
EXPORT_GID=10

# Optional: Gemini API for WeChat SILK voice-to-text transcription (cached by audio SHA256)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_STT_MODEL=gemini-2.5-flash

# Optional: proxy container name & HTTP(S) proxy for Gemini API
PROXY_CONTAINER=mihomo-core
HTTP_PROXY=http://mihomo-core:7890
HTTPS_PROXY=http://mihomo-core:7890
NO_PROXY=localhost,127.0.0.1,192.168.0.0/16
